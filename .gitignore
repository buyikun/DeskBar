/.ops/stop-deskbar.ps1



# scripts/ 与根目录探针是 AGENTS.md 定性的「调试证据链」，默认不入库。
# 但 winlist.py / flick7.py 是 AGENTS.md §3 列出的辅助工具，用 glob 显式放行
# （git 不会为「已被忽略的目录」内的子项评估取反规则，所以用 /scripts/* 而非 /scripts/）。
/scripts/*
!/scripts/winlist.py
!/scripts/flick7.py

# .agents/skills：只保留本项目相关的 sync-frontend，其余是别的项目的 skill 副本
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/sync-frontend/

# .scratch：借鉴调研时 clone 的参考实现 + 一次性探测脚本/截图（不入库）
/.scratch/
