<Window x:Class="DeskBar.Views.SystemMonitorDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{DynamicResource FontFamilyBase}"
        FontSize="{DynamicResource FontSizeBody}"
        Title="系统监控详情"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="340"
        Height="420"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 全部色值都走 DynamicResource，由 TonePalette 按当前 tone 下发。
             下面这组默认值只是首帧占位（对应深色黑丝的观感），
             实际颜色在 ApplyTonePalette() 里整体覆盖。
             这样浅色柔雾下不会出现「深色面板 + 白色高光边」的断层。 -->
        <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#E61F1F1F"/>
        <SolidColorBrush x:Key="PanelBorderKeyBrush" Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="PanelTextPrimaryBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="PanelTextSecondaryBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="PanelTextMutedBrush" Color="#88FFFFFF"/>
        <SolidColorBrush x:Key="PanelTextStrongBrush" Color="#B3FFFFFF"/>
        <SolidColorBrush x:Key="PanelCardBrush" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="PanelCardBorderBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="PanelTrackBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="PanelActionBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="PanelActionHoverBrush" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="PanelActionPressedBrush" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="PanelActionBorderBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="PanelActionHoverBorderBrush" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FF80D8FF"/>
        <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#FFB0BEC5"/>
        <!-- 指标分类色的首帧占位，实际值由 ApplyTonePalette() 按 tone 覆盖 -->
        <SolidColorBrush x:Key="MetricCpuBrush" Color="#FF4FA8E8"/>
        <SolidColorBrush x:Key="MetricMemoryBrush" Color="#FF3FC16E"/>
        <SolidColorBrush x:Key="MetricNetworkBrush" Color="#FF3FD6F5"/>
        <SolidColorBrush x:Key="MetricSparkBrush" Color="#FFF5C242"/>

        <!-- 紧凑按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelActionBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PanelTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelActionBorderBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBase}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="{DynamicResource RadiusControl}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelActionHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PanelActionHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelActionPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 硬件指标卡片样式 -->
        <Style x:Key="MetricCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <!-- 面板本体直接铺满窗口，不留 Margin：底色交给 DWM 亚克力，
         再由 RootBorder 半透明着色。留 Margin 会露出一圈没有材质的裸区，
         在非分层窗口上就是一条死黑边。 -->
    <Border x:Name="RootBorder"
            CornerRadius="{DynamicResource RadiusShell}"
            Background="{DynamicResource PanelSurfaceBrush}"
            BorderBrush="{DynamicResource PanelBorderKeyBrush}"
            BorderThickness="1">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题 -->
                <RowDefinition Height="Auto"/> <!-- 硬件统计区 -->
                <RowDefinition Height="Auto"/> <!-- 进程表头 -->
                <RowDefinition Height="*"/>    <!-- Top 进程列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部快捷动作 -->
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MetricSparkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="系统资源全景监控" FontSize="{DynamicResource FontSizeSection}" FontWeight="SemiBold" Foreground="{DynamicResource PanelTextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="BtnClose"
                        Content="✕"
                        Width="22" Height="22"
                        Background="Transparent"
                        Foreground="{DynamicResource PanelTextStrongBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="11"
                        Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="{DynamicResource RadiusMicro}" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelActionHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PanelTextPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. 核心硬件卡片 (Grid 2列) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CPU -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource PanelTextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailCpuVal" Text="--%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PanelTextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="DetailCpuBar" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource MetricCpuBrush}" Background="{DynamicResource PanelTrackBrush}" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- 内存 -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="内存" FontSize="11" Foreground="{DynamicResource PanelTextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailMemVal" Text="--%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PanelTextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="DetailMemBar" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{DynamicResource MetricMemoryBrush}" Background="{DynamicResource PanelTrackBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="DetailMemSub" Text="-- / -- GB" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource PanelTextMutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- 网络 -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="网络速率" FontSize="11" Foreground="{DynamicResource PanelTextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="↑" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MetricNetworkBrush}" Margin="0,0,3,0"/>
                            <TextBlock x:Name="DetailNetUp" Text="0.00 KB/s" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PanelTextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="↓" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MetricNetworkBrush}" Margin="0,0,3,0"/>
                            <TextBlock x:Name="DetailNetDown" Text="0.00 KB/s" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PanelTextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPU 与 磁盘 -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU 占用" FontSize="11" Foreground="{DynamicResource PanelTextSecondaryBrush}"/>
                            <TextBlock x:Name="DetailGpuVal" Text="--%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PanelTextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Background="{DynamicResource PanelTrackBrush}" Margin="0,4"/>
                        <TextBlock Text="磁盘吞吐" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource PanelTextSecondaryBrush}"/>
                        <TextBlock x:Name="DetailDiskVal" Text="R: 0.0 MB/s | W: 0.0 MB/s" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource AccentSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. 高占用进程排行 (Top-5) -->
            <Grid Grid.Row="2" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="活跃应用 (聚合归并)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PanelTextStrongBrush}"/>
                <TextBlock Grid.Column="1" Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PanelTextStrongBrush}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="内存" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PanelTextStrongBrush}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- 4. 进程列表容器 -->
            <Border Grid.Row="3" Background="{DynamicResource PanelCardBrush}" CornerRadius="{DynamicResource RadiusControl}" Padding="6" BorderBrush="{DynamicResource PanelCardBorderBrush}" BorderThickness="1">
                <ItemsControl x:Name="ListProcesses">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <!-- 应用名 -->
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11" Foreground="{DynamicResource PanelTextPrimaryBrush}" 
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                <!-- CPU 占用 -->
                                <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat='{}{0:0.0}%'}" FontSize="11" 
                                           Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <!-- 内存占用 -->
                                <TextBlock Grid.Column="2" Text="{Binding MemoryFormatted}" FontSize="11" 
                                           Foreground="{DynamicResource AccentSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 5. 底部快捷工具栏 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnResmon" Content="资源监视器" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="BtnTaskmgr" Content="任务管理器" Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
