<Window x:Class="DeskBar.Views.SystemMonitorDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统监控详情"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="340"
        Height="420"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 紧凑按钮样式 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 硬件指标卡片样式 -->
        <Style x:Key="MetricCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="#E61F1F1F"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题 -->
                <RowDefinition Height="Auto"/> <!-- 硬件统计区 -->
                <RowDefinition Height="Auto"/> <!-- 进程表头 -->
                <RowDefinition Height="*"/>    <!-- Top 进程列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部快捷动作 -->
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" Foreground="#FFD700" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="系统资源全景监控" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="BtnClose"
                        Content="✕"
                        Width="22" Height="22"
                        Background="Transparent"
                        Foreground="#B3FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="11"
                        Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#44FFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. 核心硬件卡片 (Grid 2列) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CPU -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU" FontSize="11" Foreground="#99FFFFFF"/>
                            <TextBlock x:Name="DetailCpuVal" Text="--%" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="DetailCpuBar" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#0078D4" Background="#33FFFFFF" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- 内存 -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="内存" FontSize="11" Foreground="#99FFFFFF"/>
                            <TextBlock x:Name="DetailMemVal" Text="--%" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="DetailMemBar" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#107C41" Background="#33FFFFFF" BorderThickness="0"/>
                        <TextBlock x:Name="DetailMemSub" Text="-- / -- GB" FontSize="9" Foreground="#88FFFFFF" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- 网络 -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="网络速率" FontSize="11" Foreground="#99FFFFFF"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="↑" FontSize="10" Foreground="#00BCF2" Margin="0,0,3,0"/>
                            <TextBlock x:Name="DetailNetUp" Text="0.00 KB/s" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="↓" FontSize="10" Foreground="#00BCF2" Margin="0,0,3,0"/>
                            <TextBlock x:Name="DetailNetDown" Text="0.00 KB/s" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- GPU 与 磁盘 -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU 占用" FontSize="11" Foreground="#99FFFFFF"/>
                            <TextBlock x:Name="DetailGpuVal" Text="--%" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Background="#22FFFFFF" Margin="0,4"/>
                        <TextBlock Text="磁盘吞吐" FontSize="10" Foreground="#99FFFFFF"/>
                        <TextBlock x:Name="DetailDiskVal" Text="R: 0.0 MB/s | W: 0.0 MB/s" FontSize="10" Foreground="#CCCCCC" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. 高占用进程排行 (Top-5) -->
            <Grid Grid.Row="2" Margin="2,0,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="65"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="活跃应用 (聚合归并)" FontSize="11" FontWeight="SemiBold" Foreground="#B3FFFFFF"/>
                <TextBlock Grid.Column="1" Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="#B3FFFFFF" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="内存" FontSize="11" FontWeight="SemiBold" Foreground="#B3FFFFFF" HorizontalAlignment="Right"/>
            </Grid>

            <!-- 4. 进程列表容器 -->
            <Border Grid.Row="3" Background="#14FFFFFF" CornerRadius="8" Padding="6" BorderBrush="#22FFFFFF" BorderThickness="1">
                <ItemsControl x:Name="ListProcesses">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <!-- 应用名 -->
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="11" Foreground="#FFFFFFFF" 
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                <!-- CPU 占用 -->
                                <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat='{}{0:0.0}%'}" FontSize="11" 
                                           Foreground="#80D8FF" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <!-- 内存占用 -->
                                <TextBlock Grid.Column="2" Text="{Binding MemoryFormatted}" FontSize="11" 
                                           Foreground="#B0BEC5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 5. 底部快捷工具栏 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnResmon" Content="资源监视器" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="BtnTaskmgr" Content="任务管理器" Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
