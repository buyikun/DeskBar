<Window x:Class="DeskBar.Views.IslandBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBarIslandBorder"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="False"
        Focusable="False"
        Width="220" Height="48">
    <!-- 单一细线，与音乐胶囊 / 系统信息浮岛用同一个颜色与圆角。
         描边色按 tone 在代码里下发（浅色柔雾走黑色系、深色黑丝走白色系），
         这里不给硬编码默认值，免得第一次绘制闪一下错误的颜色。 -->
    <Border x:Name="Edge"
            CornerRadius="24"
            BorderThickness="1"
            Background="Transparent"
            IsHitTestVisible="False" />
</Window>
