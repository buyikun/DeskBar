<Window x:Class="DeskBar.Views.IslandBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBarIslandBorder"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="False"
        Width="220" Height="48">
    <!-- 单一细线，与音乐胶囊 / 系统信息浮岛用同一个颜色与圆角。 -->
    <Border x:Name="Edge"
            CornerRadius="24"
            BorderThickness="1"
            BorderBrush="#38000000"
            Background="Transparent"
            IsHitTestVisible="False" />
</Window>
