<Window x:Class="DeskBar.Views.SystemMonitorCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBarSystemMonitor"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        Height="44"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- 描边色按 tone 下发：浅色柔雾走黑色系压边，深色黑丝走白色系提边。
             默认值只是首帧占位，代码在 RefreshBackground 里会覆盖。
             前景/轨道同理 —— 缺了默认值首帧会回落到 WPF 默认黑字，
             在深色任务栏上一闪而过。默认值统一取深色系，与本机默认观感一致。 -->
        <SolidColorBrush x:Key="CapsuleBorderBrush" Color="#38000000"/>
        <SolidColorBrush x:Key="CapsuleTextBrush" Color="#FFEDEAE5"/>
        <SolidColorBrush x:Key="CapsuleTextMutedBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="CapsuleTrackBrush" Color="#33FFFFFF"/>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="8"
            Background="#01000000"
            BorderBrush="{DynamicResource CapsuleBorderBrush}"
            BorderThickness="1"
            Padding="10,0"
            Cursor="Hand"
            ToolTip="点击查看硬件概览与高占用进程排行">
        <StackPanel x:Name="PanelItems"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">

            <!-- CPU -->
            <StackPanel x:Name="ItemCpu"
                        Width="34"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <TextBlock Text="CPU"
                           FontSize="9"
                           Foreground="{DynamicResource CapsuleTextMutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtCpu"
                           Text="--"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CapsuleTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,1,0,0"/>
                <Border Width="26"
                        Height="3"
                        CornerRadius="1.5"
                        Background="{DynamicResource CapsuleTrackBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0">
                    <Border x:Name="BarCpu"
                            Width="0"
                            Height="3"
                            CornerRadius="1.5"
                            Background="{DynamicResource CapsuleTextBrush}"
                            HorizontalAlignment="Left"/>
                </Border>
            </StackPanel>

            <!-- GPU -->
            <StackPanel x:Name="ItemGpu"
                        Width="34"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <TextBlock Text="GPU"
                           FontSize="9"
                           Foreground="{DynamicResource CapsuleTextMutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtGpu"
                           Text="--"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CapsuleTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,1,0,0"/>
                <Border Width="26"
                        Height="3"
                        CornerRadius="1.5"
                        Background="{DynamicResource CapsuleTrackBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0">
                    <Border x:Name="BarGpu"
                            Width="0"
                            Height="3"
                            CornerRadius="1.5"
                            Background="{DynamicResource CapsuleTextBrush}"
                            HorizontalAlignment="Left"/>
                </Border>
            </StackPanel>

            <!-- 内存 -->
            <StackPanel x:Name="ItemMem"
                        Width="34"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <TextBlock Text="内存"
                           FontSize="9"
                           Foreground="{DynamicResource CapsuleTextMutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtMem"
                           Text="--"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CapsuleTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,1,0,0"/>
                <Border Width="26"
                        Height="3"
                        CornerRadius="1.5"
                        Background="{DynamicResource CapsuleTrackBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,2,0,0">
                    <Border x:Name="BarMem"
                            Width="0"
                            Height="3"
                            CornerRadius="1.5"
                            Background="{DynamicResource CapsuleTextBrush}"
                            HorizontalAlignment="Left"/>
                </Border>
            </StackPanel>

            <!-- 网络：上排上传、下排下载（无进度条） -->
            <StackPanel x:Name="ItemNet"
                        Width="74"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2191;"
                               FontSize="9"
                               Foreground="{DynamicResource CapsuleTextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"/>
                    <TextBlock x:Name="TxtNetUp"
                               Text="--"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CapsuleTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="&#x2193;"
                               FontSize="9"
                               Foreground="{DynamicResource CapsuleTextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,3,0"/>
                    <TextBlock x:Name="TxtNetDown"
                               Text="--"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CapsuleTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
