<Window x:Class="DeskBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBar 设置" Height="700" Width="920"
        MinHeight="580" MinWidth="820"
        Icon="pack://application:,,,/DeskBar;component/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{DynamicResource FontFamilyBase}" FontSize="{DynamicResource FontSizeBody}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>

        <!--  卡片  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusShell}" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="3,4,0,8" />
        </Style>

        <!--  「自动主题」页的两个顶层分区标题：比 GroupTitle 高一级，用来一眼区分「改自己」和「改系统」  -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,2" />
        </Style>

        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,0,0,10" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  提示 / 警告文案  -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="WarnHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="#E0A030" />
        </Style>

        <Style x:Key="BadHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="#E05252" />
        </Style>

        <!--  开关  -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="{DynamicResource TrackOffBrush}"
                                CornerRadius="{DynamicResource RadiusPill}" Padding="3">
                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     Fill="{DynamicResource ToggleKnobBrush}"
                                     HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  按钮  -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusControl}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  强调按钮  -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!--  小标签按钮（常见播放器一键填入）  -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusControl}" SnapsToDevicePixels="True"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  小标签按钮选中态（已在白名单里）  -->
        <!--  用强调色描边+文字而不是填充背景：ChipButton 模板里的 hover/pressed 触发器
              优先级高于 Style setter，填背景的话一悬停就掉色，看起来像没选中。  -->
        <Style x:Key="ChipButtonOn" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  输入框  -->
        <Style x:Key="ModernText" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusControl}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  下拉框  -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}"
                                Margin="4,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource ControlBgBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" SnapsToDevicePixels="True">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,11,0" Data="M0,0 L3.5,3.5 L7,0"
                                                  Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelBox" IsHitTestVisible="False"
                                              Margin="10,0,28,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusControlOuter}" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="0,3" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  分段选择（浅色 / 深色）  -->
        <Style x:Key="SegmentItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}"
                                Padding="15,5" Margin="2">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusControlOuter}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!--  侧边导航项  -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource RadiusControl}"
                                Padding="11,9" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Fill="Transparent"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavText" Grid.Column="1" Margin="9,0,0,0"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="26,20,26,8" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,3" />
        </Style>

        <Style x:Key="PageDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  状态条  -->
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusShell}" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!--  色调预览色块：做成任务栏条的横条比例，比正方形更接近实际观感  -->
        <Style x:Key="ToneSwatch" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMicro}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧导航  -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,20,16,22">
                    <Border Width="24" Height="24" CornerRadius="{DynamicResource RadiusControlOuter}"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="D" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="DeskBar" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="9,0">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}"
                                 Content="通用" GroupName="Nav" IsChecked="True"
                                 Tag="M8,1 V3 M8,13 V15 M1,8 H3 M13,8 H15 M3.1,3.1 L4.5,4.5 M11.5,11.5 L12.9,12.9 M12.9,3.1 L11.5,4.5 M4.5,11.5 L3.1,12.9 M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 Z"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}"
                                 Content="外观" GroupName="Nav"
                                 Tag="M1,2.5 H15 V13.5 H1 Z M1,7.2 H15 M13.2,8.6 H13.2 M10.6,8.6 H10.6"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavTheme" Style="{StaticResource NavItem}"
                                 Content="自动主题" GroupName="Nav"
                                 Tag="M13.4,10.6 A6,6 0 0 1 5.4,2.6 A6.6,6.6 0 1 0 13.4,10.6 Z"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavWidgets" Style="{StaticResource NavItem}"
                                 Content="小部件" GroupName="Nav"
                                 Tag="M1.5,1.5 H6.5 V6.5 H1.5 Z M9.5,1.5 H14.5 V6.5 H9.5 Z M1.5,9.5 H6.5 V14.5 H1.5 Z M9.5,9.5 H14.5 V14.5 H9.5 Z"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavUpdate" Style="{StaticResource NavItem}"
                                 Content="检查更新" GroupName="Nav"
                                 Tag="M8,1 V11 M8,11 L4.8,7.8 M8,11 L11.2,7.8 M1.6,13.4 H14.4"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavDiag" Style="{StaticResource NavItem}"
                                 Content="诊断与日志" GroupName="Nav"
                                 Tag="M8,1.6 A6.4,6.4 0 1 1 7.99,1.6 Z M8,11.6 V11.7 M8,8.4 V4.8"
                                 Checked="OnNavClick" />
                </StackPanel>

                <TextBlock Grid.Row="2" x:Name="TxtVersion" Text="v0.1.0"
                           FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                           Margin="20,0,20,16" />
            </Grid>
        </Border>

        <!--  右侧内容  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  页 1：通用  -->
            <ScrollViewer x:Name="PageGeneral" Style="{StaticResource PageScroller}">
                <StackPanel>
                    <TextBlock Text="通用" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageDesc}"
                               Text="启动方式、托盘与桌面图标的日常行为。这些设置都不影响任务栏外观。" />

                    <TextBlock Text="启动" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox x:Name="ChkStartup" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                                <StackPanel>
                                    <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="登录 Windows 后自动在后台运行，不弹出任何窗口。" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="托盘与桌面" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox x:Name="ChkShowTray" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnShowTrayChanged" Unchecked="OnShowTrayChanged" />
                                <StackPanel>
                                    <TextBlock Text="显示托盘图标" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="关闭后进程仍在后台运行；再次启动 DeskBar 即可呼出本窗口。" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,10" />

                            <DockPanel>
                                <CheckBox x:Name="ChkDoubleClick" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnDoubleClickChanged" Unchecked="OnDoubleClickChanged" />
                                <StackPanel>
                                    <TextBlock Text="双击桌面空白处切换图标" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="双击桌面空白区域显示或隐藏所有桌面图标。只响应空白处，不影响图标本身的双击。" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  页 2：外观  -->
            <ScrollViewer x:Name="PageAppearance" Style="{StaticResource PageScroller}">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageDesc}"
                               Text="任务栏与浮岛的材质。改变后立即生效，无需重启资源管理器。" />

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="ChkTranslucentTaskbar" Style="{StaticResource ToggleSwitch}"
                                      DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Checked="OnTranslucentTaskbarChanged" Unchecked="OnTranslucentTaskbarChanged" />
                            <StackPanel>
                                <TextBlock Text="启用任务栏美化" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDesc}"
                                           Text="关闭后立即还原为 Windows 原生任务栏外观，下方所有选项随之失效。" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="任务栏风格" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="布局" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="TxtStyleDesc" Style="{StaticResource RowDesc}"
                                               Text="居中岛屿：把开始区与托盘区各挖成独立浮岛，中间透出壁纸。" />
                                </StackPanel>
                                <ComboBox x:Name="CmbTaskbarStyle" Grid.Column="1" Width="286"
                                          Style="{StaticResource ModernCombo}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"
                                          SelectionChanged="OnTaskbarStyleChanged">
                                    <ComboBoxItem Content="居中岛屿 · 挖空开始区与托盘区" Tag="island_acrylic" IsSelected="True" />
                                    <ComboBoxItem Content="整条磨砂 · 全宽毛玻璃" Tag="acrylic" />
                                    <ComboBoxItem Content="整条全透明 · 完全透出壁纸" Tag="clear" />
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="材质色调" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="TxtToneDesc" Style="{StaticResource RowDesc}"
                                               Text="决定磨砂层的颜色与不透明度。原味自然几乎不着色，直接透出壁纸。" />
                                    <TextBlock x:Name="TxtToneLocked" Style="{StaticResource WarnHint}"
                                               Text="自动主题已接管色调，请到「自动主题」页分别为白天与夜晚指定材质。"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <ComboBox x:Name="CmbAcrylicTone" Grid.Column="1" Width="228"
                                          Style="{StaticResource ModernCombo}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"
                                          SelectionChanged="OnAcrylicToneChanged">
                                    <ComboBoxItem Content="原味自然 · 完全透出壁纸（0% 覆盖）" Tag="natural" IsSelected="True" />
                                    <ComboBoxItem Content="柔雾 · 浅灰薄雾（15% 覆盖）" Tag="softmist" />
                                    <ComboBoxItem Content="黑丝 · 深灰薄纱（15% 覆盖）" Tag="sheertights" />
                                    <ComboBoxItem Content="白玉磨砂 · 奶白厚磨砂（63% 覆盖）" Tag="light" />
                                    <ComboBoxItem Content="黑曜石 · 石墨厚磨砂（56% 覆盖）" Tag="dark" />
                                </ComboBox>
                                <Border x:Name="ToneSwatch" Grid.Column="2" Style="{StaticResource ToneSwatch}"
                                        Background="Transparent" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="磨砂强度" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="模糊半径。过大可能拖慢低端 GPU 的桌面合成。" />
                                    <TextBlock x:Name="TxtBlurUnsupported" Style="{StaticResource WarnHint}"
                                               Text="当前系统的任务栏模糊接口不可用，已回退为固定亚克力，此项暂不生效。"
                                               Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Slider x:Name="SldBlurAmount" Width="180" Minimum="0" Maximum="100"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="OnBlurAmountChanged" />
                                    <TextBlock x:Name="TxtBlurValue" Text="18" Width="34"
                                               FontSize="12" TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BdRuntimeHint" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TxtRuntimeTitle" Style="{StaticResource RowTitle}"
                                       Text="运行状态" />
                            <TextBlock x:Name="TxtRuntimeHint" Style="{StaticResource Hint}" Text="" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  页 3：自动主题（核心重做）  -->
            <ScrollViewer x:Name="PageTheme" Style="{StaticResource PageScroller}">
                <StackPanel>
                    <TextBlock Text="自动主题" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageDesc}"
                               Text="分白天与夜晚两个时段，每个时段各自决定界面用浅色还是深色、任务栏用什么材质。上半部分只改 DeskBar 自己的外观，下半部分决定要不要连带修改 Windows 系统主题，两者互不影响。" />

                    <!--  实时状态条  -->
                    <Border Style="{StaticResource StatusCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="BdCurrentPhase" CornerRadius="{DynamicResource RadiusMicro}" Padding="8,3"
                                            Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCurrentPhase" Text="白天"
                                                   FontSize="12" Foreground="White" />
                                    </Border>
                                    <TextBlock x:Name="TxtCurrentPlan" Margin="10,0,0,0"
                                               FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Text="浅色 · 柔雾" />
                                </StackPanel>
                                <TextBlock x:Name="TxtNextSwitch" Style="{StaticResource Hint}" Text="" />
                                <TextBlock x:Name="TxtSystemTheme" Style="{StaticResource Hint}" Text="" />
                            </StackPanel>
                            <Button x:Name="BtnApplyNow" Grid.Column="1"
                                    Style="{StaticResource ModernButton}"
                                    Content="立即应用当前时段" MinWidth="130"
                                    VerticalAlignment="Center"
                                    Click="OnApplyCurrentPlanNow" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="15" CornerRadius="{DynamicResource RadiusMicro}"
                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}" />
                                <TextBlock Text="DeskBar 自身主题" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionDesc}"
                                       Text="只改 DeskBar 自己的浮岛、设置窗与托盘菜单外观，不碰 Windows。" />

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <CheckBox x:Name="ChkAutoTimeTheme" Style="{StaticResource ToggleSwitch}"
                                      DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Checked="OnAutoTimeThemeChanged" Unchecked="OnAutoTimeThemeChanged" />
                            <StackPanel>
                                <TextBlock Text="启用按时段自动切换" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDesc}"
                                           Text="关闭后不再按时间切换，白天下方两套方案仅作保存，不会自动生效。" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="时段划分" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Text="白天开始" Style="{StaticResource RowTitle}" Margin="0,0,0,6" />
                                    <TextBox x:Name="TxtLightTime" Width="96" TextAlignment="Center"
                                             Style="{StaticResource ModernText}"
                                             GotFocus="OnTimeBoxFocus" LostFocus="OnTimeBoxLostFocus"
                                             KeyDown="OnTimeBoxKeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,22,0">
                                    <TextBlock Text="夜晚开始" Style="{StaticResource RowTitle}" Margin="0,0,0,6" />
                                    <TextBox x:Name="TxtDarkTime" Width="96" TextAlignment="Center"
                                             Style="{StaticResource ModernText}"
                                             GotFocus="OnTimeBoxFocus" LostFocus="OnTimeBoxLostFocus"
                                             KeyDown="OnTimeBoxKeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtSpanSummary" Style="{StaticResource Hint}"
                                               Text="" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TxtTimeError" Style="{StaticResource BadHint}"
                                       Text="" Visibility="Collapsed" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="24 小时制 HH:mm。夜晚开始早于白天开始表示跨夜，例如 19:00 → 07:00。" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="白天方案" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="界面配色" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="本软件自身窗口，以及（可选）Windows 全局深浅色。" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}"
                                        VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RdoDayLight" Style="{StaticResource SegmentItem}"
                                                     Content="浅色" GroupName="DayShade"
                                                     IsChecked="True" Checked="OnDayShadeChanged" />
                                        <RadioButton x:Name="RdoDayDark" Style="{StaticResource SegmentItem}"
                                                     Content="深色" GroupName="DayShade"
                                                     Checked="OnDayShadeChanged" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="任务栏材质" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="白天时段任务栏与浮岛使用的色调。" />
                                </StackPanel>
                                <ComboBox x:Name="CmbDayTone" Grid.Column="1" Width="228"
                                          Style="{StaticResource ModernCombo}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"
                                          SelectionChanged="OnDayToneChanged">
                                    <ComboBoxItem Content="原味自然 · 完全透出壁纸（0% 覆盖）" Tag="natural" />
                                    <ComboBoxItem Content="柔雾 · 浅灰薄雾（15% 覆盖）" Tag="softmist" IsSelected="True" />
                                    <ComboBoxItem Content="黑丝 · 深灰薄纱（15% 覆盖）" Tag="sheertights" />
                                    <ComboBoxItem Content="白玉磨砂 · 奶白厚磨砂（63% 覆盖）" Tag="light" />
                                    <ComboBoxItem Content="黑曜石 · 石墨厚磨砂（56% 覆盖）" Tag="dark" />
                                </ComboBox>
                                <Border x:Name="DayToneSwatch" Grid.Column="2" Style="{StaticResource ToneSwatch}"
                                        Background="Transparent" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="夜晚方案" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="界面配色" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="可与白天相同，也可以昼夜颠倒。" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}"
                                        VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RdoNightLight" Style="{StaticResource SegmentItem}"
                                                     Content="浅色" GroupName="NightShade"
                                                     Checked="OnNightShadeChanged" />
                                        <RadioButton x:Name="RdoNightDark" Style="{StaticResource SegmentItem}"
                                                     Content="深色" GroupName="NightShade"
                                                     IsChecked="True" Checked="OnNightShadeChanged" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="任务栏材质" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="夜晚时段任务栏与浮岛使用的色调。" />
                                </StackPanel>
                                <ComboBox x:Name="CmbNightTone" Grid.Column="1" Width="228"
                                          Style="{StaticResource ModernCombo}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"
                                          SelectionChanged="OnNightToneChanged">
                                    <ComboBoxItem Content="原味自然 · 完全透出壁纸（0% 覆盖）" Tag="natural" />
                                    <ComboBoxItem Content="柔雾 · 浅灰薄雾（15% 覆盖）" Tag="softmist" />
                                    <ComboBoxItem Content="黑丝 · 深灰薄纱（15% 覆盖）" Tag="sheertights" IsSelected="True" />
                                    <ComboBoxItem Content="白玉磨砂 · 奶白厚磨砂（63% 覆盖）" Tag="light" />
                                    <ComboBoxItem Content="黑曜石 · 石墨厚磨砂（56% 覆盖）" Tag="dark" />
                                </ComboBox>
                                <Border x:Name="NightToneSwatch" Grid.Column="2" Style="{StaticResource ToneSwatch}"
                                        Background="Transparent" />
                            </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="15" CornerRadius="{DynamicResource RadiusMicro}"
                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}" />
                                <TextBlock Text="Windows 系统主题" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SectionDesc}"
                                       Text="这一段改的是 Windows 自己的深浅色设置，等于替你在「设置 → 个性化 → 颜色」里点一下。" />

                            <TextBlock Style="{StaticResource WarnHint}"
                                       Text="注意：开启后 DeskBar 会写入系统注册表并广播刷新消息，效果等同于手动在「设置 → 个性化 → 颜色」里切换。若完全不想影响系统外观，请关闭下面的总开关。" />

                            <DockPanel Margin="0,10,0,0">
                                <CheckBox x:Name="ChkApplySystemTheme" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnApplySystemThemeChanged" Unchecked="OnApplySystemThemeChanged" />
                                <StackPanel>
                                    <TextBlock Text="按时段同步 Windows 主题" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="总开关。关闭后一个字节都不写，上面的「DeskBar 自身主题」照常按时段切换。" />
                                </StackPanel>
                            </DockPanel>

                            <!--  细粒度子项：分别对应 SystemUsesLightTheme 与 AppsUseLightTheme 两个注册表值  -->
                            <StackPanel Margin="18,12,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=ChkApplySystemTheme}" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <DockPanel>
                                    <CheckBox x:Name="ChkApplyWindowsMode" Style="{StaticResource ToggleSwitch}"
                                              DockPanel.Dock="Right" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsChecked, ElementName=ChkApplySystemTheme}"
                                              Checked="OnApplyWindowsModeChanged" Unchecked="OnApplyWindowsModeChanged" />
                                    <StackPanel>
                                        <TextBlock Text="Windows 模式（任务栏 / 开始菜单 / 通知中心）" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowDesc}"
                                                   Text="写入 SystemUsesLightTheme。关掉后这些系统界面保持你现在手选的样子。" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="ChkApplyAppsMode" Style="{StaticResource ToggleSwitch}"
                                              DockPanel.Dock="Right" VerticalAlignment="Center"
                                              IsEnabled="{Binding IsChecked, ElementName=ChkApplySystemTheme}"
                                              Checked="OnApplyAppsModeChanged" Unchecked="OnApplyAppsModeChanged" />
                                    <StackPanel>
                                        <TextBlock Text="应用模式（资源管理器 / 设置等应用）" Style="{StaticResource RowTitle}" />
                                        <TextBlock Style="{StaticResource RowDesc}"
                                                   Text="写入 AppsUseLightTheme。与上面一项互不影响，可以只开其中一个。" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  页 4：小部件  -->
            <ScrollViewer x:Name="PageWidgets" Style="{StaticResource PageScroller}">
                <StackPanel>
                    <TextBlock Text="小部件" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageDesc}"
                               Text="渲染在任务栏上的音乐胶囊与硬件监控浮岛。均不注入任何进程，只读取系统公开接口。" />

                    <TextBlock Text="任务栏音乐" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox x:Name="ChkMusicCapsule" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnMusicCapsuleChanged" Unchecked="OnMusicCapsuleChanged" />
                                <StackPanel>
                                    <TextBlock Text="启用任务栏音乐胶囊" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="在任务栏显示当前播放的歌曲、歌词与播放控制。通过系统媒体会话读取，无需逐个适配播放器。" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,10" />

                            <DockPanel Margin="0,0,0,10">
                                <CheckBox x:Name="ChkMusicAutoHide" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnMusicAutoHideChanged" Unchecked="OnMusicAutoHideChanged" />
                                <StackPanel>
                                    <TextBlock Text="无播放时自动隐藏" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="没有活跃的媒体会话时收起胶囊，留出任务栏空间。" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,10" />

                            <DockPanel Margin="0,0,0,10">
                                <CheckBox x:Name="ChkMusicControls" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnMusicControlsChanged" Unchecked="OnMusicControlsChanged" />
                                <StackPanel>
                                    <TextBlock Text="显示播放控制按钮" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="在胶囊内显示上一首、播放/暂停、下一首。" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="胶囊宽度" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="歌词超出宽度时自动横向滚动。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Slider x:Name="SldMusicWidth" Width="150" Minimum="200" Maximum="520"
                                            TickFrequency="10" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="OnMusicWidthChanged" />
                                    <TextBlock x:Name="TxtMusicWidthValue" Text="250 px" Width="48"
                                               FontSize="12" TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,10" />

                            <StackPanel>
                                <TextBlock Text="播放器白名单" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDesc}"
                                           Text="只接管这里列出的播放器，防止浏览器的视频、游戏语音等抢占胶囊。留空表示接受所有播放器。中文名和进程名都认，例如 QQ音乐、cloudmusic、Spotify；多个用逗号分隔。" />
                                <TextBox x:Name="TxtMusicWhitelist" Margin="0,9,0,0"
                                         Style="{StaticResource ModernText}"
                                         ToolTip="可以填中文名（QQ音乐）或进程名（QQMusic.exe），逗号、顿号、空格都能分隔"
                                         TextChanged="OnMusicWhitelistChanged" />
                                <TextBlock Text="常见播放器（点一下加入，再点一下移除）" Style="{StaticResource Hint}" />
                                <WrapPanel x:Name="PnlWhitelistPresets" Margin="0,5,0,0" />
                                <TextBlock x:Name="TxtWhitelistStatus" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="任务栏系统监控" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="ChkSystemMonitor" Style="{StaticResource ToggleSwitch}"
                                      DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Checked="OnSystemMonitorChanged" Unchecked="OnSystemMonitorChanged" />
                            <StackPanel>
                                <TextBlock Text="启用硬件监控浮岛" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDesc}"
                                           Text="在任务栏左侧显示 CPU / 内存 / 网络 / GPU，每秒刷新。点击可展开详情。" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  页 5：诊断与日志  -->
            <!--  页 5：检查更新  -->
            <ScrollViewer x:Name="PageUpdate" Style="{StaticResource PageScroller}">
                <StackPanel>
                    <TextBlock Text="检查更新" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageDesc}"
                               Text="从 GitHub Releases 获取最新版本。检查更新只在点击时发起请求，不做后台轮询。" />

                    <TextBlock Text="版本" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Button x:Name="BtnCheckUpdate" DockPanel.Dock="Right"
                                        Style="{StaticResource AccentButton}" Content="检查更新"
                                        MinWidth="104" Click="OnCheckUpdate" />
                                <StackPanel>
                                    <TextBlock x:Name="TxtUpdateCurrent" Style="{StaticResource RowTitle}"
                                               Text="当前版本 —" />
                                    <TextBlock x:Name="TxtUpdateStatus" Style="{StaticResource RowDesc}"
                                               Text="尚未检查。点击右侧按钮获取最新版本信息。" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,12" />

                            <DockPanel Margin="0,0,0,10">
                                <CheckBox x:Name="ChkAutoCheckUpdate" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnAutoCheckUpdateChanged" Unchecked="OnAutoCheckUpdateChanged" />
                                <StackPanel>
                                    <TextBlock Text="启动后自动检查更新" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="开启后每次启动会在后台静默检查一次，不弹窗打扰。" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="更新说明" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Border Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="10,8">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtUpdateNotes" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource SubTextBrush}"
                                               Text="检查更新后，这里会显示最新版本的发行说明。" />
                                </ScrollViewer>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BtnInstallUpdate" Style="{StaticResource AccentButton}"
                                        Content="立即更新" MinWidth="120" IsEnabled="False"
                                        Click="OnInstallUpdate" />
                                <Button x:Name="BtnDownloadUpdate" Style="{StaticResource ModernButton}"
                                        Content="仅下载安装包" MinWidth="120" Margin="8,0,0,0"
                                        IsEnabled="False" Click="OnDownloadUpdate" />
                                <Button x:Name="BtnOpenReleasePage" Style="{StaticResource ModernButton}"
                                        Content="打开发布页" MinWidth="104" Margin="8,0,0,0"
                                        IsEnabled="False" Click="OnOpenReleasePage" />
                            </StackPanel>
                            <ProgressBar x:Name="BarUpdate" Height="3" Margin="0,12,0,0"
                                         Minimum="0" Maximum="100" Value="0"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ControlBgBrush}"
                                         BorderThickness="0" Visibility="Collapsed" />
                            <TextBlock x:Name="TxtUpdateProgress" Style="{StaticResource Hint}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="下载加速" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowDesc}" Margin="0,0,0,8"
                                       Text="GitHub 下载直链在国内经常连不上。填写中转前缀后，下载地址会自动改写为「前缀 + 原始 GitHub 地址」。留空表示直连。" />
                            <TextBox x:Name="TxtAccelPrefix" Style="{StaticResource ModernText}"
                                     TextChanged="OnAccelPrefixChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ChipButton}" Content="默认加速"
                                        Click="OnResetAccelPrefix" />
                                <Button Style="{StaticResource ChipButton}" Content="直连 GitHub"
                                        Margin="8,0,0,0" Click="OnUseDirectGitHub" />
                            </StackPanel>
                            <TextBlock x:Name="TxtAccelPreview" Style="{StaticResource Hint}"
                                       Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="示例：https://github.com/buyikun/DeskBar/releases/download/v2.0.0/..." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PageDiag" Style="{StaticResource PageScroller}">
                <StackPanel>
                    <TextBlock Text="诊断与日志" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageDesc}"
                               Text="排查异常时才需要用到。日常使用建议保持默认，避免额外写盘。" />

                    <TextBlock Text="运行日志" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <CheckBox x:Name="ChkDebugLog" Style="{StaticResource ToggleSwitch}"
                                          DockPanel.Dock="Right" VerticalAlignment="Center"
                                          Checked="OnDebugLogChanged" Unchecked="OnDebugLogChanged" />
                                <StackPanel>
                                    <TextBlock Text="记录运行调试日志" Style="{StaticResource RowTitle}" />
                                    <TextBlock Style="{StaticResource RowDesc}"
                                               Text="默认关闭以免频繁写盘；错误日志不受此开关影响，始终会记录。" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ModernButton}" Content="打开日志目录"
                                        MinWidth="112" Click="OnOpenLogDir" />
                                <Button Style="{StaticResource ModernButton}" Content="清空日志"
                                        MinWidth="96" Margin="8,0,0,0" Click="OnClearLogs" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="系统探测" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource ModernButton}" Content="切换桌面图标"
                                        MinWidth="120" Click="OnToggleIconsNow" />
                                <Button Style="{StaticResource ModernButton}" Content="探测系统层级"
                                        MinWidth="120" Margin="8,0,0,0" Click="OnProbeWindows" />
                            </StackPanel>
                            <Border Background="{DynamicResource ControlBgBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusControl}" Padding="10,8">
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtProbe" Text="尚未探测。"
                                               FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  底部操作栏  -->
            <Border Grid.Row="1" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Padding="22,12">
                <Grid>
                    <TextBlock x:Name="TxtFooterHint" VerticalAlignment="Center"
                               FontSize="11" TextWrapping="NoWrap"
                               Foreground="{DynamicResource SubTextBrush}"
                               Text="所有设置即时生效并自动保存。" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernButton}" Content="隐藏到托盘"
                                MinWidth="96" Click="OnHideToTray" />
                        <Button Style="{StaticResource ModernButton}" Content="关闭"
                                MinWidth="80" Margin="8,0,0,0" Click="OnClose" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
