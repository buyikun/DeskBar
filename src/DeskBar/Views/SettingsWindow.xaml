<Window x:Class="DeskBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBar 设置" Height="660" Width="900"
        MinHeight="560" MinWidth="800"
        Icon="pack://application:,,,/DeskBar;component/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>

        <!--  卡片  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="3,2,0,8" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  开关  -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="{DynamicResource TrackOffBrush}"
                                CornerRadius="11" Padding="3">
                            <Ellipse x:Name="Knob" Width="16" Height="16"
                                     Fill="{DynamicResource ToggleKnobBrush}"
                                     HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  按钮  -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  输入框  -->
        <Style x:Key="ModernText" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  下拉框  -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Margin="4,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource ControlBgBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,11,0" Data="M0,0 L3.5,3.5 L7,0"
                                                  Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelBox" IsHitTestVisible="False"
                                              Margin="10,0,28,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1" CornerRadius="7" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" Margin="0,3" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  侧边导航项  -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7"
                                Padding="11,9" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.3"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Fill="Transparent"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavText" Grid.Column="1" Margin="9,0,0,0"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}" />
                                <Setter TargetName="NavText" Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="26,20,26,8" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,3" />
        </Style>

        <Style x:Key="PageDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,18" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧导航  -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,20,16,22">
                    <Border Width="24" Height="24" CornerRadius="7"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="D" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="DeskBar" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="9,0">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}"
                                 Content="通用设置" GroupName="Nav" IsChecked="True"
                                 Tag="M8,1 V3 M8,13 V15 M1,8 H3 M13,8 H15 M3.1,3.1 L4.5,4.5 M11.5,11.5 L12.9,12.9 M12.9,3.1 L11.5,4.5 M4.5,11.5 L3.1,12.9 M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 Z"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavTaskbar" Style="{StaticResource NavItem}"
                                 Content="任务栏美化" GroupName="Nav"
                                 Tag="M1,2.5 H15 V13.5 H1 Z M1,7.2 H15 M13.2,8.6 H13.2 M10.6,8.6 H10.6"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavTheme" Style="{StaticResource NavItem}"
                                 Content="自动主题" GroupName="Nav"
                                 Tag="M13.4,10.6 A6,6 0 0 1 5.4,2.6 A6.6,6.6 0 1 0 13.4,10.6 Z"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavWidgets" Style="{StaticResource NavItem}"
                                 Content="小部件" GroupName="Nav"
                                 Tag="M1.5,1.5 H6.5 V6.5 H1.5 Z M9.5,1.5 H14.5 V6.5 H9.5 Z M1.5,9.5 H6.5 V14.5 H1.5 Z M9.5,9.5 H14.5 V14.5 H9.5 Z"
                                 Checked="OnNavClick" />
                    <RadioButton x:Name="NavDiag" Style="{StaticResource NavItem}"
                                 Content="诊断" GroupName="Nav"
                                 Tag="M8,1.6 A6.4,6.4 0 1 1 7.99,1.6 Z M8,11.6 V11.7 M8,8.4 V4.8"
                                 Checked="OnNavClick" />
                </StackPanel>

                <TextBlock Grid.Row="2" x:Name="TxtVersion" Text="v0.1.0"
                           FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                           Margin="20,0,20,16" />
            </Grid>
        </Border>

        <!--  右侧内容  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  页 1：通用  -->
            <ScrollViewer x:Name="PageGeneral" Style="{StaticResource PageScroller}">
                <StackPanel>
                    <TextBlock Text="通用设置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="启动方式、托盘与桌面图标的日常行为" Style="{StaticResource PageDesc}" />

                    <TextBlock Text="启动" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox x:Name="ChkStartup" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="登录 Windows 后自动在后台运行 DeskBar" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <CheckBox x:Name="ChkShowTray" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnShowTrayChanged" Unchecked="OnShowTrayChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="显示托盘图标" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="隐藏后仍可通过再次运行 DeskBar 呼出设置窗口" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="桌面" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="ChkDoubleClick" DockPanel.Dock="Right"
                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      Checked="OnDoubleClickChanged" Unchecked="OnDoubleClickChanged" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="双击桌面空白切换图标" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="双击桌面空白区域，一键显示或隐藏全部桌面图标" Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  页 2：任务栏美化  -->
            <ScrollViewer x:Name="PageTaskbar" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="任务栏美化" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="透明、亚克力与居中止岛外观" Style="{StaticResource PageDesc}" />

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="ChkTranslucentTaskbar" DockPanel.Dock="Right"
                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      Checked="OnTranslucentTaskbarChanged" Unchecked="OnTranslucentTaskbarChanged" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启用任务栏美化" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="关闭后立即还原为 Windows 原生任务栏外观" Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="任务栏风格" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <ComboBox x:Name="CmbTaskbarStyle" DockPanel.Dock="Right"
                                          Style="{StaticResource ModernCombo}" Width="270"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnTaskbarStyleChanged">
                                    <ComboBoxItem Content="部分亚克力 · 居中岛屿 + 托盘岛屿" Tag="island_acrylic" />
                                    <ComboBoxItem Content="全透明 · 整条透出壁纸" Tag="clear" />
                                    <ComboBoxItem Content="全亚克力 · 整条毛玻璃" Tag="acrylic" />
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="外观样式" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="岛屿模式只保留图标区域的玻璃质感" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <ComboBox x:Name="CmbAcrylicTone" DockPanel.Dock="Right"
                                          Style="{StaticResource ModernCombo}" Width="270"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnAcrylicToneChanged">
                                    <ComboBoxItem Content="原味自然亚克力（图中同款）" Tag="natural" />
                                    <ComboBoxItem Content="浅色白玉磨砂（清爽透亮）" Tag="light" />
                                    <ComboBoxItem Content="深色黑曜石（暗色沉稳）" Tag="dark" />
                                    <ComboBoxItem Content="随系统自动（昼浅夜深）" Tag="auto" />
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="亚克力色调" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="决定毛玻璃的底色倾向与透明度" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  页 3：自动主题  -->
            <ScrollViewer x:Name="PageTheme" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="自动主题" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="按时间自动切换 Windows 深浅色模式" Style="{StaticResource PageDesc}" />

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="ChkAutoTimeTheme" DockPanel.Dock="Right"
                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      Checked="OnAutoTimeThemeChanged" Unchecked="OnAutoTimeThemeChanged" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启用定时自动切换" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="到达设定时刻自动切换系统与应用的深浅配色" Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="切换时刻" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBox x:Name="TxtLightTime" DockPanel.Dock="Right" Width="90"
                                         Style="{StaticResource ModernText}" TextAlignment="Center"
                                         Text="07:00" TextChanged="OnTimeConfigChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="浅色模式开始" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="24 小时制，格式 HH:mm" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBox x:Name="TxtDarkTime" DockPanel.Dock="Right" Width="90"
                                         Style="{StaticResource ModernText}" TextAlignment="Center"
                                         Text="19:00" TextChanged="OnTimeConfigChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="深色模式开始" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="24 小时制，格式 HH:mm" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Content="立即切换为浅色" Style="{StaticResource ModernButton}"
                                        Click="OnManualSwitchLight" />
                                <Button Content="立即切换为深色" Style="{StaticResource ModernButton}"
                                        Margin="14,0,0,0" Click="OnManualSwitchDark" />
                            </StackPanel>
                            <TextBlock x:Name="TxtThemeStatus" Style="{StaticResource RowDesc}"
                                       Margin="0,12,0,0" Text="当前系统：正在读取..." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  页 4：小部件  -->
            <ScrollViewer x:Name="PageWidgets" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="小部件" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="渲染在任务栏上的音乐胶囊与硬件监控浮岛" Style="{StaticResource PageDesc}" />

                    <TextBlock Text="任务栏音乐" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox x:Name="ChkMusicCapsule" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnMusicCapsuleChanged" Unchecked="OnMusicCapsuleChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="启用任务栏音乐胶囊" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="在托盘左侧显示封面、曲名与播放控制" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox x:Name="ChkMusicAutoHide" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnMusicAutoHideChanged" Unchecked="OnMusicAutoHideChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="无播放时自动隐藏" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="保持任务栏紧凑，不留空白占位" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox x:Name="ChkMusicControls" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnMusicControlsChanged" Unchecked="OnMusicControlsChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="显示播放控制按钮" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="上一曲 / 播放暂停 / 下一曲" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel>
                                <TextBox x:Name="TxtMusicWhitelist" DockPanel.Dock="Right" Width="270"
                                         Style="{StaticResource ModernText}"
                                         ToolTip="留空 = 接受所有播放器；多个用逗号分隔"
                                         TextChanged="OnMusicWhitelistChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="播放器白名单" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="留空接受全部；可填 QQMusic / cloudmusic / Spotify 等" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="任务栏系统监控" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <CheckBox x:Name="ChkSystemMonitor" DockPanel.Dock="Right"
                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      Checked="OnSystemMonitorChanged" Unchecked="OnSystemMonitorChanged" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启用硬件监控浮岛" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="任务栏左侧显示 CPU / 内存 / 网络 / GPU，每秒刷新，不注入任何进程"
                                           Style="{StaticResource RowDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  页 5：诊断  -->
            <ScrollViewer x:Name="PageDiag" Style="{StaticResource PageScroller}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="诊断" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="运行日志与系统层级探测，供排查问题时使用" Style="{StaticResource PageDesc}" />

                    <TextBlock Text="运行日志" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <CheckBox x:Name="ChkDebugLog" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnDebugLogChanged" Unchecked="OnDebugLogChanged" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="记录运行调试日志" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="默认关闭以免写盘；仅在排查问题时开启" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开日志目录" Style="{StaticResource ModernButton}"
                                        Click="OnOpenLogDir" />
                                <Button Content="清空日志" Style="{StaticResource ModernButton}"
                                        Margin="8,0,0,0" Click="OnClearLogs" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="系统探测" Style="{StaticResource GroupTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button x:Name="BtnToggleIcons" Content="立即切换桌面图标"
                                        Style="{StaticResource ModernButton}" Click="OnToggleIconsNow" />
                                <Button x:Name="BtnProbe" Content="探测系统层级"
                                        Style="{StaticResource ModernButton}" Margin="8,0,0,0"
                                        Click="OnProbeWindows" />
                            </StackPanel>
                            <TextBlock x:Name="TxtProbe" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  底部操作栏  -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="22,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="隐藏到托盘" Style="{StaticResource ModernButton}"
                            Margin="0,0,10,0" Click="OnHideToTray" />
                    <Button Content="关闭" Style="{StaticResource ModernButton}"
                            Width="80" Click="OnClose" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
