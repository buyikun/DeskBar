<Application x:Class="DeskBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBackground" Color="#202020" />
            <SolidColorBrush x:Key="CardBackground" Color="#2B2B2B" />
            <SolidColorBrush x:Key="ForegroundBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="SubTextBrush" Color="#A8A8A8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4C8BF5" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#171717" />
            <SolidColorBrush x:Key="ControlBgBrush" Color="#303030" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#3E3E3E" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="NavHoverBrush" Color="#222222" />
            <SolidColorBrush x:Key="NavActiveBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="TrackOffBrush" Color="#4A4A4A" />
            <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
