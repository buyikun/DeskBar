<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseSharedCompilation>false</UseSharedCompilation>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskBar</AssemblyName>
    <RootNamespace>DeskBar</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>2.3.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会往 ImplicitUsings 里塞 System.Drawing / System.Windows.Forms，
         导致 WPF 的同名类型（Color/Brush/Point/ComboBox/TextBox/KeyEventArgs…）全部歧义。
         本项目只在 TrayIconHost.cs 里用 WinForms，且那里已显式 using，所以从全局移除。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <None Update="NativeBinaries\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(FileName)%(Extension)</Link>
    </None>
    <None Update="tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
