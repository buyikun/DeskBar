<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         全应用视觉令牌（design tokens）。

         在此之前，设置窗口、右键菜单、系统监控详情窗各自写死了圆角与字号：
         卡片 10/8/12、按钮 6/6/4、描述字号 11/10/9 —— 三处没有共同来源，
         微调任何一处都会让彼此更像"两套软件拼起来"。

         这里只收敛「与配色无关」的量：圆角、字号、字体。
         颜色不放进来的原因：设置窗口跟系统深浅色走，浮岛与菜单跟材质色调走
         （浮岛浮在壁纸上，必须跟材质才融得进去）。两套光源是刻意的，
         强行合并会让浅色系统 + 深色壁纸时浮岛变成一块突兀的浅色板。
         颜色的统一放在 TonePalette.cs，圆角与字号的统一放在这里。
         ============================================================ -->

    <!-- 字体：Windows 中文界面标准字体。缺了它，菜单与详情窗会静默
         退回系统默认字体，和中文字重的行高对不上。 -->
    <FontFamily x:Key="FontFamilyBase">Microsoft YaHei UI</FontFamily>

    <!-- 圆角阶梯：四档。
         取值不是随手挑的，而是满足「嵌套时外圆角 = 内圆角 + 内边距」这条规则：
         分段控件外壳 8 = 内部选项 6 + padding 2，两层弧线同心，不会出现
         内层直角顶破外层圆弧的错位。

         Shell        —— 内容卡片、菜单外壳、详情面板（最外层容器）
         ControlOuter —— 包着子控件的容器：分段控件外壳、下拉弹层、Logo 方块
         Control      —— 按钮、输入框、菜单项、导航项、下拉项、指标卡
         Micro        —— 徽章、色块这类小尺寸标记 -->
    <CornerRadius x:Key="RadiusShell">10</CornerRadius>
    <CornerRadius x:Key="RadiusControlOuter">8</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusMicro">4</CornerRadius>

    <!-- 胶囊半径：不是一个审美取值，而是几何约束 —— 必须严格等于控件高度的一半，
         否则两端会出现「平顶」或「收缩」。开关轨道高 22 → 11，标签按钮高 24 → 12。
         因为它随高度变化，所以单独一格，不能和上面的阶梯混用。 -->
    <CornerRadius x:Key="RadiusPill">11</CornerRadius>

    <!-- 字号阶梯。最小 11：9px 与 10px 在高 DPI 下会糊成一片，
         详情窗原来用 9px 的"单位说明"就是这个毛病。 -->
    <sys:Double x:Key="FontSizeTitle">19</sys:Double>
    <sys:Double x:Key="FontSizeSection">13</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>

</ResourceDictionary>
